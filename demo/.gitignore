# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Models / large files (also enforced by checkpoints/.gitignore)
*.pkl
*.npz
*.ckpt
*.pth
*.pt
*.bin

# Notebook outputs (commit clean cells only)
# Use: jupyter nbconvert --clear-output --inplace notebooks/*.ipynb

# OS / IDE
.DS_Store
.idea/
.vscode/

# Generated artifacts (regenerable from notebooks)
results/*.gif
results/*.mp4
# keep static demo PNGs and the .obj smoke artifact
!results/.gitkeep
